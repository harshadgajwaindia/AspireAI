# Frontend Environment Variables

# Production Backend API URL (for Vercel deployment)
# Set this to your Render backend URL when deploying
# Example: https://aspire-ai-backend.onrender.com
# In development, leave empty to use Vite proxy (/api -> localhost:8080)
VITE_API_BASE_URL=

# Development mode (optional)
# VITE_APP_ENV=development
